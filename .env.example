# ============================================================
# HireVanta — Environment Variables (placeholders only)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# ---- App ----
# Public base URL of the deployment (used for links in emails, OG, sitemap)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Database (PostgreSQL + Prisma) ----
# Example: postgresql://user:password@host:5432/hirevanta?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hirevanta?schema=public"

# ---- Auth (admin dashboard) ----
# A long random string (e.g. `openssl rand -base64 48`). Used to sign JWT session cookies.
AUTH_SECRET="replace-with-a-long-random-secret-string"
# Session lifetime in seconds (default 8h)
AUTH_SESSION_TTL="28800"

# Initial admin account (used by `npm run db:seed`)
ADMIN_EMAIL="admin@hirevanta.com"
ADMIN_PASSWORD="change-this-strong-password"
ADMIN_NAME="HireVanta Admin"

# ---- Email (choose ONE provider) ----
# Provider selector: "resend" | "smtp" | "console"
# "console" logs emails to the server console (safe default for local dev).
EMAIL_PROVIDER="console"

# Address that receives all applications & inquiries
NOTIFY_EMAIL="hirevanta0@gmail.com"
# From address shown in notification emails (must be a verified sender for your provider)
EMAIL_FROM="HireVanta <no-reply@hirevanta.com>"

# -- Resend --
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"

# -- SMTP (e.g. Gmail with an App Password, SendGrid, Amazon SES SMTP) --
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-smtp-username"
# For Gmail use an App Password, NOT your normal account password.
SMTP_PASSWORD="your-smtp-app-password"

# ---- File storage (choose ONE) ----
# "local" stores files under ./.storage (dev only). "s3" uses an S3-compatible bucket.
STORAGE_PROVIDER="local"

# -- S3 / S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2) --
S3_REGION="us-east-1"
S3_BUCKET="hirevanta-resumes"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
# Optional: custom endpoint for R2/MinIO (leave blank for AWS S3)
S3_ENDPOINT=""
# Force path-style addressing (needed for MinIO / some providers)
S3_FORCE_PATH_STYLE="false"
# Seconds a presigned resume download link stays valid
S3_SIGNED_URL_TTL="900"

# ---- Uploads ----
# Max resume size in bytes (default 5 MB)
MAX_UPLOAD_BYTES="5242880"

# ---- Rate limiting / anti-spam ----
# Max public form submissions per IP per window
RATE_LIMIT_MAX="5"
# Window length in seconds
RATE_LIMIT_WINDOW="600"
